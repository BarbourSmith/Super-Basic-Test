    {
      "atomType": "Code",
      "x": 0.325497287522604,
      "y": 0.3231197771587744,
      "uniqueID": "id-614",
      "ioValues": [
        {
          "name": "teeth",
          "ioValue": 20
        },
        {
          "name": "pitch",
          "ioValue": 5
        },
        {
          "name": "thickness",
          "ioValue": 5
        }
      ],
      "interpreterVersion": 0,
      "code": "const Inputs = [\n  { inputName: \"teeth\", type: \"number\", defaultValue: 20 },\n  { inputName: \"pitch\", type: \"number\", defaultValue: 5 },\n  { inputName: \"thickness\", type: \"number\", defaultValue: 5 },\n];\n\nconst N = Math.max(3, Math.round(teeth));\nconst p = pitch;\nconst m = p / Math.PI;                         // module\nconst pitchR = (N * p) / (2 * Math.PI);        // pitch radius\nconst addR = pitchR + m;                       // addendum (tooth tip)\nconst rootR = Math.max(0.1, pitchR - 1.25 * m); // dedendum (root)\n\nconst toothAngle = (2 * Math.PI) / N;\nconst half = toothAngle / 2;\nconst tipHalf = half * 0.35;   // tooth tip width\nconst rootHalf = half * 0.9;   // tooth root width\n\nconst pts = [];\nfor (let i = 0; i < N; i++) {\n  const a = i * toothAngle;\n  pts.push([rootR * Math.cos(a - rootHalf), rootR * Math.sin(a - rootHalf)]);\n  pts.push([addR  * Math.cos(a - tipHalf),  addR  * Math.sin(a - tipHalf)]);\n  pts.push([addR  * Math.cos(a + tipHalf),  addR  * Math.sin(a + tipHalf)]);\n  pts.push([rootR * Math.cos(a + rootHalf), rootR * Math.sin(a + rootHalf)]);\n}\n\nlet pen = replicad.draw(pts[0]);\nfor (let i = 1; i < pts.length; i++) pen = pen.lineTo(pts[i]);\nconst drawing = pen.close();\n\nconst solid = drawing.sketchOnPlane().extrude(thickness);\nreturn { geometry: [solid], dimension: \"3D\", tags: [], color: \"#aad7f2\", plane: null, bom: [] };"
    },
    {
      "atomType": "Code",
      "x": 0.5998677248677249,
      "y": 0.37325905292479106,
      "uniqueID": "id-708",
      "ioValues": [
        {
          "name": "shape",
          "ioValue": "__GEOMETRY_INPUT__"
        },
        {
          "name": "count",
          "ioValue": 6
        },
        {
          "name": "offset",
          "ioValue": 15
        }
      ],
      "interpreterVersion": 1,
      "code": "\n/**\n * This code atom implements a simple linear layout funtion which repeats\n * shape count times in the positive X direction with offset space\n * between each. Works for either 2D or 3D shapes. Negative offset\n * and negative counts invert the direction.\n * \n * Notice that defaults are set for both count and offset.\n */\nfunction run(shape: Assembly, count: number = 1, offset: number = 5) {\n  if (count == 0) {\n    return []\n  }\n  const isReversed = count < 0;\n  if (isReversed) {\n    offset = -1 * offset\n  }\n  count = Math.abs(count)\n\n  const result = [shape]\n  for (let i = 1; i < count; i++) {\n    const movedCopy = new Assembly(shape).onLeafs((leaf) => {\n      if (leaf.is2D()) {\n        leaf.geometry = leaf.geometry.translate(offset * i, 0)\n      } else if (leaf.geometry instanceof replicad._3DShape) {\n        leaf.geometry = leaf.geometry.translate(offset * i, 0, 0)\n      }\n      return leaf;\n    })\n\n    if (movedCopy) {\n      result.push(movedCopy)\n    }\n  }\n\n  return result;\n}\n",
      "compiledCode": "\"use strict\";\n/**\n * This code atom implements a simple linear layout funtion which repeats\n * shape count times in the positive X direction with offset space\n * between each. Works for either 2D or 3D shapes. Negative offset\n * and negative counts invert the direction.\n *\n * Notice that defaults are set for both count and offset.\n */\nfunction run(shape, count = 1, offset = 5) {\n    if (count == 0) {\n        return [];\n    }\n    const isReversed = count < 0;\n    if (isReversed) {\n        offset = -1 * offset;\n    }\n    count = Math.abs(count);\n    const result = [shape];\n    for (let i = 1; i < count; i++) {\n        const movedCopy = new Assembly(shape).onLeafs((leaf) => {\n            if (leaf.is2D()) {\n                leaf.geometry = leaf.geometry.translate(offset * i, 0);\n            }\n            else if (leaf.geometry instanceof replicad._3DShape) {\n                leaf.geometry = leaf.geometry.translate(offset * i, 0, 0);\n            }\n            return leaf;\n        });\n        if (movedCopy) {\n            result.push(movedCopy);\n        }\n    }\n    return result;\n}\n"
    },
