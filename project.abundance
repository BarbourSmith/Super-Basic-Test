        {
          "atomType": "Code",
          "x": 0.9,
          "y": 0.3,
          "uniqueID": "id-2535",
          "name": "Helical Pattern",
          "ioValues": [
            {
              "name": "shape",
              "ioValue": "__GEOMETRY_INPUT__"
            },
            {
              "name": "count",
              "ioValue": 15
            },
            {
              "name": "angle",
              "ioValue": 35
            },
            {
              "name": "rise",
              "ioValue": 192
            }
          ],
          "interpreterVersion": 1,
          "code": "/**\n * Helical pattern: like RotatePattern, but each copy also rises.\n * Copy i is rotated i * angle degrees about the Z axis and moved up i * rise.\n */\nfunction run(\n  shape: Assembly,\n  count: number = 12,\n  angle: number = 30,\n  rise: number = 190,\n): Assembly[] {\n  const copies: Assembly[] = [];\n  for (let i = 0; i < Math.round(count); i++) {\n    const copy = new Assembly(shape).onLeafs((leaf) => {\n      if (leaf.is2D()) throw new Error(\"Helical Pattern needs 3D shapes\");\n      leaf.geometry = leaf.geometry\n        .clone()\n        .rotate(angle * i, [0, 0, 0], [0, 0, 1])\n        .translate(0, 0, rise * i);\n      return leaf;\n    });\n    if (copy) copies.push(copy);\n  }\n  return copies;\n}\n",
          "compiledCode": "\"use strict\";\n/**\n * Helical pattern: like RotatePattern, but each copy also rises.\n * Copy i is rotated i * angle degrees about the Z axis and moved up i * rise.\n */\nfunction run(shape, count = 12, angle = 30, rise = 190) {\n    const copies = [];\n    for (let i = 0; i < Math.round(count); i++) {\n        const copy = new Assembly(shape).onLeafs((leaf) => {\n            if (leaf.is2D())\n                throw new Error(\"Helical Pattern needs 3D shapes\");\n            leaf.geometry = leaf.geometry\n                .clone()\n                .rotate(angle * i, [0, 0, 0], [0, 0, 1])\n                .translate(0, 0, rise * i);\n            return leaf;\n        });\n        if (copy)\n            copies.push(copy);\n    }\n    return copies;\n}\n"
        },
